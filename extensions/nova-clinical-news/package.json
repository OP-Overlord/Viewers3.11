{
  "name": "nova-clinical-news",
  "version": "1.0.0",
  "description": "Clinical News Agent - Monitors PubMed for relevant radiology articles",
  "author": "NOVA Imaging",
  "license": "MIT",
  "main": "dist/nova-extension-clinical-news.umd.js",
  "module": "src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "ohif-extension"
  ],
  "scripts": {
