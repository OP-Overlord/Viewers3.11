    "build:package": "yarn run build"
  },
  "peerDependencies": {
    "@ohif/core": "3.11.0-beta.107",
    "@ohif/ui-next": "3.11.0-beta.107",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@babel/runtime": "^7.20.13"
  }
}
